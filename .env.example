# ============ Environment ============
APP_ENV=development
APP_SERVICE_NAME=multi-modal-input-processor
APP_VERSION=1.0.0
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ============ Server ============
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4

# ============ Redis / Cache ============
APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_ENABLED=true
APP_CACHE_TTL=300

# ============ Storage ============
# storage_backend: local | s3
APP_STORAGE_BACKEND=local
APP_STORAGE_LOCAL_PATH=./storage
APP_S3_ENDPOINT=
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
APP_S3_BUCKET=input-processor
APP_S3_REGION=us-east-1

# ============ Security ============
# CHANGE THIS IN PRODUCTION
APP_JWT_SECRET_KEY=change-me-to-a-strong-random-value
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_API_KEY_REQUIRED=false
APP_CORS_ORIGINS=*
APP_RATE_LIMIT_PER_MINUTE=100
APP_MAX_REQUEST_SIZE_MB=50

# ============ Text processor ============
APP_TEXT_MAX_LENGTH=10000

# ============ Image processor ============
APP_IMAGE_MAX_SIZE_MB=20
APP_IMAGE_RECOGNITION_PROVIDER=local
APP_AZURE_CV_ENDPOINT=
APP_AZURE_CV_KEY=

# ============ Link processor ============
APP_LINK_TIMEOUT=10
APP_LINK_USER_AGENT=ShoppingAI-InputProcessor/1.0

# ============ Voice processor ============
APP_VOICE_MAX_SIZE_MB=20
APP_VOICE_MAX_DURATION_SECONDS=300
APP_SPEECH_PROVIDER=local
APP_SPEECH_DEFAULT_LANGUAGE=zh-CN
APP_AZURE_SPEECH_KEY=
APP_AZURE_SPEECH_REGION=

# ============ Session ============
APP_SESSION_MAX_AGE_HOURS=24
APP_SESSION_CLEANUP_INTERVAL_MINUTES=60

# ============ Monitoring ============
APP_METRICS_ENABLED=true
APP_TRACING_ENABLED=false
