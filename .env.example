# ============ Environment ============
APP_ENV=development
APP_SERVICE_NAME=multi-modal-input-processor
APP_VERSION=1.0.0
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ============ Server ============
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4

# ============ Redis / Cache ============
APP_REDIS_URL=redis://localhost:6379/0
APP_CACHE_ENABLED=true
APP_CACHE_TTL=300

# ============ Storage ============
# storage_backend: local | s3
APP_STORAGE_BACKEND=local
APP_STORAGE_LOCAL_PATH=./storage
APP_S3_ENDPOINT=
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
APP_S3_BUCKET=input-processor
APP_S3_REGION=us-east-1

# ============ Security ============
# CHANGE THIS IN PRODUCTION
APP_JWT_SECRET_KEY=change-me-to-a-strong-random-value
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_API_KEY_REQUIRED=false
APP_CORS_ORIGINS=*
APP_RATE_LIMIT_PER_MINUTE=100
APP_MAX_REQUEST_SIZE_MB=50

# ============ Text processor ============
APP_TEXT_MAX_LENGTH=10000

# ============ Image processor ============
APP_IMAGE_MAX_SIZE_MB=20
APP_IMAGE_RECOGNITION_PROVIDER=local
APP_AZURE_CV_ENDPOINT=
APP_AZURE_CV_KEY=

# ============ Link processor ============
APP_LINK_TIMEOUT=10
APP_LINK_USER_AGENT=ShoppingAI-InputProcessor/1.0

# ============ Voice processor ============
APP_VOICE_MAX_SIZE_MB=20
APP_VOICE_MAX_DURATION_SECONDS=300
APP_SPEECH_PROVIDER=local
APP_SPEECH_DEFAULT_LANGUAGE=zh-CN
APP_AZURE_SPEECH_KEY=
APP_AZURE_SPEECH_REGION=

# ============ Session ============
APP_SESSION_MAX_AGE_HOURS=24
APP_SESSION_CLEANUP_INTERVAL_MINUTES=60

# ============ Monitoring ============
APP_METRICS_ENABLED=true
APP_TRACING_ENABLED=false

# ================================================
# Part 2: Gateway (prefix GW_)
# ================================================
GW_ENV=development
GW_PORT=8001
GW_WORKERS=4
GW_DEBUG=true
GW_LOG_LEVEL=INFO

# Upstream Part 1 (input processor)
GW_UPSTREAM_BASE_URL=http://localhost:8000
GW_UPSTREAM_TIMEOUT_SECONDS=30
GW_UPSTREAM_MAX_RETRIES=2

# Redis (used for rate limiter + token blacklist)
GW_REDIS_URL=redis://localhost:6379/1

# Security (ROTATE IN PRODUCTION)
GW_JWT_SECRET_KEY=change-me-to-a-strong-random-value-at-least-32-bytes
GW_JWT_ACCESS_MINUTES=30
GW_JWT_REFRESH_DAYS=7
GW_API_KEY_REQUIRED=false
GW_API_KEYS=
GW_CORS_ORIGINS=*

# Rate limiting (requests per minute, per user type)
GW_RL_B2B_PURCHASER_PER_MINUTE=1000
GW_RL_B2C_CONSUMER_PER_MINUTE=100
GW_RL_PARTNER_PER_MINUTE=5000
GW_RL_INTERNAL_PER_MINUTE=10000
GW_RL_ANONYMOUS_PER_MINUTE=20

# Circuit breaker
GW_CB_FAILURE_THRESHOLD=5
GW_CB_RECOVERY_SECONDS=30
GW_CB_HALF_OPEN_MAX_CALLS=3

# WebSocket
GW_WS_MAX_CONNECTIONS=10000
GW_WS_HEARTBEAT_SECONDS=30
GW_WS_IDLE_TIMEOUT_SECONDS=300
GW_WS_MAX_MESSAGE_SIZE_KB=256

GW_METRICS_ENABLED=true

# ================================================
# Part 3.1: Intent Recognition Service (prefix INTENT_)
# ================================================
INTENT_ENV=development
INTENT_PORT=8002
INTENT_WORKERS=2
INTENT_DEBUG=true
INTENT_LOG_LEVEL=INFO

# Classifier: rules | transformer | ensemble
INTENT_BACKEND=ensemble
INTENT_DEFAULT_LANGUAGE=zh-CN
INTENT_SUPPORTED_LANGUAGES=zh-CN,en
INTENT_CONFIDENT_THRESHOLD=0.70
INTENT_LOW_CONFIDENCE_THRESHOLD=0.55
INTENT_TOP_K=3
INTENT_MAX_TEXT_LENGTH=2000

# Transformer backend (optional). Requires torch + transformers at runtime.
INTENT_MODEL_NAME_OR_PATH=bert-base-multilingual-cased
INTENT_MODEL_CACHE_DIR=
INTENT_MODEL_MAX_SEQ_LENGTH=128
INTENT_MODEL_DEVICE=auto
INTENT_MODEL_BATCH_SIZE=16
INTENT_ALLOW_RULES_FALLBACK=true
INTENT_PRELOAD_MODEL=false

# Cache / circuit breaker
INTENT_CACHE_ENABLED=true
INTENT_REDIS_URL=redis://localhost:6379/2
INTENT_CACHE_TTL_SECONDS=600
INTENT_MEMORY_CACHE_SIZE=4096
INTENT_CB_FAILURE_THRESHOLD=5
INTENT_CB_RECOVERY_SECONDS=30

# Security
INTENT_API_KEY_REQUIRED=false
INTENT_API_KEYS=
INTENT_CORS_ORIGINS=*
INTENT_METRICS_ENABLED=true

# ================================================
# Part 3.2: Decision Engine (prefix DECISION_)
# ================================================
DECISION_ENV=development
DECISION_PORT=8003
DECISION_WORKERS=2
DECISION_DEBUG=true
DECISION_LOG_LEVEL=INFO

# Strategy: rules | ml | ensemble
DECISION_STRATEGY=ensemble
DECISION_ENSEMBLE_RULES_WEIGHT=0.5
DECISION_ENSEMBLE_ML_WEIGHT=0.5
DECISION_LOW_CONFIDENCE_THRESHOLD=0.55
DECISION_CONFIDENT_THRESHOLD=0.65
DECISION_RISK_REVIEW_THRESHOLD=0.70
DECISION_TOP_K_ALTERNATIVES=3
DECISION_MAX_BATCH_SIZE=64

# ML strategy (optional). Set ml_model_kind=dummy to use the zero-dep
# fallback model that ships with the service.
DECISION_ML_MODEL_KIND=dummy
DECISION_ML_MODEL_PATH=
DECISION_ML_DEVICE=cpu
DECISION_ML_BATCH_SIZE=16
DECISION_ALLOW_RULES_FALLBACK=true
DECISION_PRELOAD_MODEL=false

# Cache / circuit breaker
DECISION_CACHE_ENABLED=true
DECISION_REDIS_URL=redis://localhost:6379/3
DECISION_CACHE_TTL_SECONDS=300
DECISION_MEMORY_CACHE_SIZE=2048
DECISION_CB_FAILURE_THRESHOLD=5
DECISION_CB_RECOVERY_SECONDS=30

# Policy guardrails
DECISION_MAX_AUTO_APPROVE_AMOUNT=50000
DECISION_REQUIRE_HUMAN_REVIEW_ABOVE=100000
DECISION_DEFAULT_LANGUAGE=zh-CN
DECISION_SUPPORTED_LANGUAGES=zh-CN,en

# Security
DECISION_API_KEY_REQUIRED=false
DECISION_API_KEYS=
DECISION_CORS_ORIGINS=*
DECISION_METRICS_ENABLED=true

# ================================================
# Part 3.3: LLM Service (prefix LLM_)
# ================================================
LLM_ENV=development
LLM_PORT=8004
LLM_WORKERS=2
LLM_DEBUG=true
LLM_LOG_LEVEL=INFO

# Routing: single | fallback | parallel_any | parallel_vote | confidence
LLM_DEFAULT_STRATEGY=fallback
LLM_DEFAULT_MODEL_ID=stub-small
# Comma-separated fallback chain of model ids (must exist in the catalog).
LLM_FALLBACK_CHAIN=stub-small
LLM_PARALLEL_FANOUT=3
LLM_CONFIDENT_THRESHOLD=0.65
LLM_LOW_CONFIDENCE_THRESHOLD=0.45
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_BATCH_SIZE=32

# Prompt + sampling defaults
LLM_MAX_PROMPT_CHARS=32000
LLM_MAX_COMPLETION_TOKENS=1024
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_TOP_P=1.0

# Provider credentials (all optional; stub provider works without any)
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_ORGANIZATION=

LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

LLM_GOOGLE_API_KEY=
LLM_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1

LLM_AZURE_API_KEY=
LLM_AZURE_ENDPOINT=
LLM_AZURE_API_VERSION=2024-02-01

# Cache / circuit breaker / rate limit
LLM_CACHE_ENABLED=true
LLM_REDIS_URL=redis://localhost:6379/4
LLM_CACHE_TTL_SECONDS=600
LLM_MEMORY_CACHE_SIZE=2048
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_RECOVERY_SECONDS=30
LLM_RATE_LIMIT_PER_MINUTE=300
LLM_RATE_LIMIT_BURST=60

# Budget guard (per-request cap in USD)
LLM_MAX_REQUEST_COST_USD=1.00

# Security
LLM_API_KEY_REQUIRED=false
LLM_API_KEYS=
LLM_CORS_ORIGINS=*
LLM_METRICS_ENABLED=true
